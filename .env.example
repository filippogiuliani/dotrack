# ===== doTrack – configuration =====

# Public address of the app (used in email links, the OIDC callback and the Google Calendar feed).
# Google Calendar must be able to reach it from the internet to read the feed.
DOTRACK_URL=https://dotrack.example.com

# Time zone (dates and times of appointments, hour of the reminder emails)
TZ=Europe/Rome
# Hour (0-23) after which the daily reminder email is sent; also the default hour of push reminders
DOTRACK_REMINDER_HOUR=8

# Sign-up: "open" (anyone) or "closed" (only through an invitation link)
DOTRACK_SIGNUP=open

# In production behind HTTPS: cookies only over secure connections
DOTRACK_COOKIE_SECURE=1
# Set to 1 when a reverse proxy sits in front (nginx, Caddy, Traefik…)
DOTRACK_PROXY=1

# Email (address confirmation, password recovery and daily reminders). Without SMTP emails are only written to the log.
DOTRACK_SMTP_HOST=
DOTRACK_SMTP_PORT=587
DOTRACK_SMTP_USER=
DOTRACK_SMTP_PASSWORD=
DOTRACK_MAIL_FROM=doTrack <noreply@example.com>

# Email/password sign-in and sign-up. Set to 0 to allow only the OIDC providers below (configure at least one).
DOTRACK_PASSWORD_LOGIN=1

# Sign-in with external providers (OpenID Connect), comma separated. Leave empty to disable.
# Callback URL to register with the provider: <DOTRACK_URL>/api/oidc/<name>/callback
DOTRACK_OIDC=
# Google (console.cloud.google.com → Credentials → OAuth client ID, "Web application")
DOTRACK_OIDC_GOOGLE_ID=
DOTRACK_OIDC_GOOGLE_SECRET=
# Any other OIDC provider, e.g. DOTRACK_OIDC=google,microsoft
# DOTRACK_OIDC_MICROSOFT_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# DOTRACK_OIDC_MICROSOFT_ID=
# DOTRACK_OIDC_MICROSOFT_SECRET=
# DOTRACK_OIDC_MICROSOFT_NAME=Microsoft
# Self-hosted providers work the same way, e.g. DOTRACK_OIDC=authentik
# DOTRACK_OIDC_AUTHENTIK_ISSUER=https://auth.example.com/application/o/dotrack
# DOTRACK_OIDC_AUTHENTIK_ID=
# DOTRACK_OIDC_AUTHENTIK_SECRET=
# DOTRACK_OIDC_AUTHENTIK_NAME=Authentik

# How many daily automatic database backups to keep
DOTRACK_BACKUP_KEEP=30

# ----- weHub: one sign-in and one family for all the family apps (optional) -----
# With these set, sign-in goes only through the OIDC provider (the same Pocket ID as weHub) and the family, its
# members and people are managed in weHub. Key: the same as WEHUB_APP_DOTRACK_KEY in weHub.
DOTRACK_HUB_URL=
DOTRACK_HUB_KEY=
# Address of weHub for people (links), if different from DOTRACK_HUB_URL (e.g. an internal Docker address)
DOTRACK_HUB_PUBLIC_URL=
